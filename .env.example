# Configuración de Stripe (Producción o Pruebas)
# IMPORTANTE: Ambas claves deben ser del mismo entorno:
# - En modo Pruebas: STRIPE_SECRET_KEY inicia con sk_test_ y NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY con pk_test_
# - En modo Producción: STRIPE_SECRET_KEY inicia con sk_live_ y NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY con pk_live_
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secreto de Webhooks de Stripe (obtenido del Dashboard de Stripe -> Desarrolladores -> Webhooks o Stripe CLI)
STRIPE_WEBHOOK_SECRET=whsec_...

# URL base pública de la aplicación (para redirección de retornos y webhooks en producción)
NEXT_PUBLIC_SITE_URL=https://kinexting.com

# Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

